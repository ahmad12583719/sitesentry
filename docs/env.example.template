# SiteSentry is local-first. No cloud credentials, analytics keys, or third-party API keys are required.
# Optional path to the SQLite credential file. Default: ~/.sitesentry/sitesentry.db
SITESENTRY_DB_PATH=~/.sitesentry/sitesentry.db

# Optional local binding configuration. Keep 127.0.0.1 unless you intentionally need another local binding.
SITESENTRY_HOST=127.0.0.1
SITESENTRY_PORT=5123

# Optional persistent session secret. If unset, one is securely generated and stored in the local SQLite file.
# SITESENTRY_SESSION_SECRET=replace-with-a-long-random-string
